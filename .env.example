# Copy to .env.local, or run `npm run setup:env` to create it with fresh random values.
# Never commit .env.local.

# The advisor's LLM. Leave the key empty, or set LLM_PROVIDER=off, to run on tappable choices alone.
LLM_PROVIDER=
# Comma-separated and tried in order. Empty uses the defaults in src/server/config.ts.
LLM_MODEL=
LLM_API_KEY=
# Optional. How long each model may take before the next one is tried.
LLM_TIMEOUT_MS=10000

# The fixed business date for all date checks, per the data pack README.
APP_TODAY=2026-07-15

# Folder holding the data pack, which stays out of git.
DATA_DIR=./YTL_TrackA_Udyam_Digital_Data

# The database. Defaults to a file under the git-ignored storage folder.
DATABASE_URL=file:storage/app.db

# Where encrypted documents and the OCR language file live. Both are git-ignored.
DOCUMENT_DIR=./storage/documents
OCR_LANG_DIR=./storage/ocr

# Signs session cookies and keys the phone hash. At least 32 characters.
SESSION_SECRET=

# 32 random bytes, base64 encoded. Wraps the per-file keys for documents and extracted fields.
# Losing it makes every stored document unreadable.
DOCUMENT_MASTER_KEY=

# PROTOTYPE ONLY. The fixed code every mock OTP accepts, which the API returns labelled as a test code.
# No real SMS is sent.
OTP_TEST_CODE=000000

# Sent as the x-admin-token header on simulation routes.
ADMIN_TOKEN=

# Sent as the x-service-token header on the mock registry routes, which are server-to-server only.
REGISTRY_SERVICE_TOKEN=

# Optional. Comma-separated origins allowed to write through the API, besides the app's own.
ALLOWED_ORIGINS=

# Optional. How long a registry lookup may take before it counts as an outage.
REGISTRY_TIMEOUT_MS=3000

# Optional. Set to false only for plain-HTTP testing away from localhost. Defaults to true in production.
COOKIE_SECURE=

# Optional. Set to true only behind a proxy that sets x-forwarded-for, because a client can send its own.
TRUST_PROXY=
